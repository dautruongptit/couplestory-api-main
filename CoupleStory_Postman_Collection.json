{
  "info": {
    "name": "CoupleStory API v2",
    "description": "Toàn bộ API cho CoupleStory",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"]},
            "body": {"mode": "raw", "raw": "{\"email\": \"test@gmail.com\", \"password\": \"123456\"}"}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]},
            "body": {"mode": "raw", "raw": "{\"email\": \"test@gmail.com\", \"password\": \"123456\"}"}
          }
        }
      ]
    },
    {
      "name": "2. Story",
      "item": [
        {
          "name": "Get My Stories",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/stories", "host": ["{{baseUrl}}"], "path": ["api", "stories"]}
          }
        },
        {
          "name": "Create Story",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/api/stories", "host": ["{{baseUrl}}"], "path": ["api", "stories"]},
            "body": {"mode": "raw", "raw": "{\"coupleName1\": \"Long\", \"coupleName2\": \"Nhiên\", \"startDate\": \"2021-05-20\"}"}
          }
        }
      ]
    },
    {
      "name": "3. Public",
      "item": [
        {
          "name": "Get Public Story",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/story?subdomain=long-nhien",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "story"],
              "query": [{"key": "subdomain", "value": "long-nhien"}]
            }
          }
        }
      ]
    }
  ]
}
