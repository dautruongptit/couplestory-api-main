# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
# Defaults match docker-compose's bundled postgres service. Point these at an external
# database instead (e.g. reachable over a private network/VPN) if you're not using it.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me

# --- Redis --- (provisioned but unused by the app today - see docker-compose.yml note)
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT --- (required in every real deployment; generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-base64-secret-at-least-32-bytes

# --- Uploaded photo storage ---
# Local disk (see LocalDiskStorageService) - no redundancy, back this directory up.
# Inside docker-compose this is fixed to /app/uploads (mounted to the uploads_data
# volume); only relevant if running the jar directly outside of docker-compose.
# UPLOADS_DIR=uploads

# --- Security ---
# true in every real (HTTPS) deployment; only ever false for local plain-HTTP dev.
COOKIE_SECURE=true
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=https://app.couplestory.example

# Leave unset for production (uses application.yml against Postgres).
# Set to "dev" only for local development (uses application-dev.yml, H2, SeedController).
# SPRING_PROFILES_ACTIVE=dev
